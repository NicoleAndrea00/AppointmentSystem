@{
    ViewData["Title"] = "System Calendar";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>System Calendar</h2>
            <p class="text-muted">All appointments across all clinicians</p>
        </div>
        <div class="col text-end">
            <a asp-action="Index" class="btn btn-outline-primary me-2">Dashboard</a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">Logout</a>
        </div>
    </div>

    <!-- Legend -->
    <div class="mb-3 d-flex gap-3">
        <span><span class="badge bg-primary">●</span> Scheduled</span>
        <span><span class="badge bg-success">●</span> Confirmed</span>
        <span><span class="badge bg-danger">●</span> Cancelled</span>
        <span><span class="badge bg-secondary">●</span> Completed</span>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div id="calendar"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                events: '/Admin/CalendarEvents',
                eventClick: function (info) {
                    alert(
                        'Appointment: ' + info.event.title + '\n' +
                        'Status: ' + info.event.extendedProps.status + '\n' +
                        'Type: ' + info.event.extendedProps.consultationType
                    );
                },
                slotMinTime: '08:00:00',
                slotMaxTime: '18:00:00',
                allDaySlot: false,
                height: 650
            });
            calendar.render();
        });
    </script>
}