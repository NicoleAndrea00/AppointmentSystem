@model MediBook.Models.Appointment

@{
    ViewData["Title"] = "Create Appointment";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Create New Appointment</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="PatientId" class="form-label">Patient</label>
                        <select asp-for="PatientId" asp-items="@(ViewBag.Patients as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)" class="form-select">
                            <option value="">-- Select Patient --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClinicianId" class="form-label">Clinician</label>
                        <select asp-for="ClinicianId" asp-items="@(ViewBag.Clinicians as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)" class="form-select">
                            <option value="">-- Select Clinician --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AppointmentDate" class="form-label">Date & Time</label>
                        <input asp-for="AppointmentDate" type="datetime-local" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Create Appointment</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>