@model IEnumerable<MediBook.Models.Appointment>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>Admin Dashboard</h2>
            <p class="text-muted">Welcome, @ViewBag.UserName</p>
        </div>
        <div class="col text-end">
            <a asp-action="Create" class="btn btn-primary">New Appointment</a>
            <a asp-action="Users" class="btn btn-outline-primary ms-2">Manage Users</a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary ms-2">Logout</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Row -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total</h5>
                    <h2>@ViewBag.TotalAppointments</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Scheduled</h5>
                    <h2>@ViewBag.ScheduledCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Confirmed</h5>
                    <h2>@ViewBag.ConfirmedCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Cancelled</h5>
                    <h2>@ViewBag.CancelledCount</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Appointments Table -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">No appointments in the system yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Date & Time</th>
                        <th>Patient</th>
                        <th>Clinician</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@appointment.Patient.FullName</td>
                            <td>Dr. @appointment.Clinician.User.FullName</td>
                            <td>
                                <span class="badge
                                    @(appointment.Status == "Scheduled" ? "bg-primary" :
                                                                            appointment.Status == "Confirmed" ? "bg-success" :
                                                                            appointment.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                    @appointment.Status
                                </span>
                            </td>
                            <td>@appointment.Notes</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@appointment.Id"
                                   class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@appointment.Id"
                                   class="btn btn-sm btn-danger ms-1">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>