@model MediBook.ViewModels.PatientDetailsViewModel

@{
    ViewData["Title"] = "Patient Details";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Back to Schedule</a>
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Patient Details</h4>
                </div>
                <div class="card-body d-flex align-items-center gap-4">
                    <img src="~/images/profiles/@Model.ProfilePicture"
                         alt="Profile Picture"
                         style="width: 80px; height: 80px; object-fit: cover; border-radius: 50%; border: 3px solid #0d6efd;" />
                    <div>
                        <h4 class="mb-0">@Model.FullName</h4>
                        <p class="text-muted mb-0">@Model.Email</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4 mt-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Add Clinical Notes</h5>
    </div>
    <div class="card-body">
        <form asp-controller="Clinician" asp-action="AddNotes" asp-route-id="@Model.Appointments.First().Id" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <textarea name="clinicianNotes" class="form-control" rows="4"
                          placeholder="Enter clinical notes here...">@Model.Appointments.First().ClinicianNotes</textarea>
            </div>
            <button type="submit" class="btn btn-primary">Save Notes</button>
        </form>
    </div>
</div>

    <div class="card shadow">
        <div class="card-header bg-light">
            <h5 class="mb-0">Appointment History</h5>
        </div>
        <div class="card-body">
            @if (!Model.Appointments.Any())
            {
                <div class="alert alert-info">No appointment history found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Date & Time</th>
                                <th>Status</th>
                                <th>Concerns</th>
                                <th>Clinical Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.Appointments)
                            {
                                <tr>
                                    <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge
                                            @(appointment.Status == "Scheduled" ? "bg-primary" :
                                                                                            appointment.Status == "Confirmed" ? "bg-success" :
                                                                                            appointment.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                            @appointment.Status
                                        </span>
                                    </td>
                                    <td>@appointment.Notes</td>
                                    <td>@appointment.ClinicianNotes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>