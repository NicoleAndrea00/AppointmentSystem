@model IEnumerable<MediBook.Models.Appointment>

@{
    ViewData["Title"] = "My Schedule";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col d-flex align-items-center gap-3">
            <img src="~/images/profiles/@ViewBag.ProfilePicture"
                 alt="Profile Picture"
                 style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%; border: 2px solid #0d6efd;" />
            <div>
                <h2 class="mb-0">Dr. @ViewBag.UserName</h2>
                <p class="text-muted mb-0">@ViewBag.Specialty</p>
            </div>
        </div>
        <div class="col text-end">
            <a asp-action="Profile" class="btn btn-outline-primary me-2">My Profile</a>
            <a asp-action="Calendar" class="btn btn-outline-success me-2">Calendar</a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">Logout</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have no appointments scheduled yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>Date & Time</th>
                        <th>Patient</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a asp-action="PatientDetails" asp-route-id="@appointment.Id"
                                       class="text-decoration-none fw-normal text-black">
                                    @appointment.Patient.FullName
                                </a>
                            </td>
                            <td>
                                <span class="badge @(appointment.ConsultationType == "Video Call" ? "bg-info" : "bg-secondary")">
                                    @appointment.ConsultationType
                                </span>
                            </td>
                            <td>
                                <span class="badge
                                    @(appointment.Status == "Scheduled" ? "bg-primary" :
                                                                            appointment.Status == "Confirmed" ? "bg-success" :
                                                                            appointment.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                    @appointment.Status
                                </span>
                            </td>
                            <td class="d-flex flex-wrap gap-1">
                                @if (appointment.Status == "Scheduled")
                                {
                                    <a asp-action="Confirm" asp-route-id="@appointment.Id"
                                       class="btn btn-sm btn-success">Confirm</a>
                                }
                                @if (appointment.Status != "Cancelled" && appointment.Status != "Completed")
                                {
                                    <a asp-action="Reschedule" asp-route-id="@appointment.Id"
                                       class="btn btn-sm btn-warning ms-1">Reschedule</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>