@model IEnumerable<MediBook.Models.Appointment>

@{
    ViewData["Title"] = "My Schedule";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>Welcome, Dr. @ViewBag.UserName</h2>
            <p class="text-muted">@ViewBag.Specialty</p>
        </div>
        <div class="col text-end">
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">Logout</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have no appointments scheduled yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>Date & Time</th>
                        <th>Patient</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@appointment.Patient.FullName</td>
                            <td>
                                <span class="badge
                                    @(appointment.Status == "Scheduled" ? "bg-primary" :
                                                                            appointment.Status == "Confirmed" ? "bg-success" :
                                                                            appointment.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                    @appointment.Status
                                </span>
                            </td>
                            <td>@appointment.Notes</td>
                            <td>
                                @if (appointment.Status == "Scheduled")
                                {
                                    <a asp-action="Confirm" asp-route-id="@appointment.Id"
                                           class="btn btn-sm btn-success">
                                        Confirm
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>