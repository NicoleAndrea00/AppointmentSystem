@{
    ViewData["Title"] = "Add Clinical Notes";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Clinical Notes</h4>
            </div>
            <div class="card-body">
                <p class="text-muted">Patient: <strong>@ViewBag.PatientName</strong></p>

                <form asp-action="AddNotes" asp-route-id="@ViewBag.AppointmentId" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Clinical Notes</label>
                        <textarea name="clinicianNotes" class="form-control" rows="6"
                                  placeholder="Enter clinical notes here...">@ViewBag.CurrentNotes</textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Save Notes</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>