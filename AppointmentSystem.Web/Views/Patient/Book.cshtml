@model MediBook.ViewModels.BookAppointment

@{
    ViewData["Title"] = "Book Appointment";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Book New Appointment</h4>
            </div>
            <div class="card-body">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                <form asp-action="Book" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ClinicianId" class="form-label">Select Clinician</label>
                        <select asp-for="ClinicianId" asp-items="Model.Clinicians" class="form-select">
                            <option value="">-- Select a Clinician --</option>
                        </select>
                        <span asp-validation-for="ClinicianId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AppointmentDate" class="form-label">Date & Time</label>
                        <input asp-for="AppointmentDate" type="datetime-local" class="form-control" min="@DateTime.Now.ToString("dd-MM-yyyy")/>
                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConsultationType" class="form-label">Consultation Type</label>
                        <select asp-for="ConsultationType" class="form-select">
                            <option value="Face to Face">Face to Face</option>
                            <option value="Video Call">Video Call</option>
                        </select>
                        <span asp-validation-for="ConsultationType" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Notes (optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="Any additional notes for your appointment"></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Confirm Booking</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>