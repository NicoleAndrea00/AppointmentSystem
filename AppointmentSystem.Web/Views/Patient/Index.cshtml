@model IEnumerable<AppointmentSystem.Web.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>Welcome, @ViewBag.UserName!</h2>
            <p class="text-muted">Here are your upcoming appointments</p>
        </div>
        <div class="col text-end">
            <a asp-action="Book" class="btn btn-primary">Book New Appointment</a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary ms-2">Logout</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have no appointments yet. Click "Book New Appointment" to get started!
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>Date & Time</th>
                        <th>Clinician</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@appointment.Clinician.User.FullName</td>
                            <td>
                                <span class="badge
                                    @(appointment.Status == "Scheduled" ? "bg-primary" :
                                                                            appointment.Status == "Confirmed" ? "bg-success" :
                                                                            appointment.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                    @appointment.Status
                                </span>
                            </td>
                            <td>@appointment.Notes</td>
                            <td>
                                @if (appointment.Status != "Cancelled" && appointment.Status != "Completed")
                                {
                                    <a asp-action="Cancel" asp-route-id="@appointment.Id"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Are you sure you want to cancel this appointment?')">
                                        Cancel
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>